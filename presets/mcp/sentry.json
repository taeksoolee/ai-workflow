{
  "description": "Sentry 이슈·이벤트 조회 (@sentry/mcp-server)",
  "servers": {
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server@latest"],
      "env": {
        "SENTRY_ACCESS_TOKEN": "${MCP_SENTRY_ACCESS_TOKEN}"
      }
    }
  },
  "envVars": [
    {
      "key": "MCP_SENTRY_ACCESS_TOKEN",
      "comment": "https://sentry.io/settings/account/api/auth-tokens/"
    }
  ]
}
