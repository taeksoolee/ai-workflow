# 이 파일을 복사해 .ai-workflow/.env 로 만들고 실제 값을 채워주세요.
#   cp .ai-workflow/.env.example .ai-workflow/.env
#   chmod 600 .ai-workflow/.env
# .ai-workflow/.env 는 gitignore 대상이며 절대 커밋하지 않습니다.
# 값이 비어 있는 크리덴셜의 MCP 서버는 aiw mcp 생성 시 자동으로 제외됩니다.

# MCP Server Credentials

## (선택) 실행 파일 절대경로 오버라이드
# 비워두면 PATH 의 npx / uvx 를 그대로 쓴다. nvm 등으로 node 가 여러 개라
# "npx 는 찾았는데 그 안의 node shebang 이 엉뚱한 버전을 가리켜" MCP 가 뜨지 않는 경우에만 채운다.
# MCP_NODE_BIN 을 채우면 aiw mcp 가 생성 시점에 `<node> <npx> -y <패키지>` 형태로 고정해준다.
#   MCP_NODE_BIN=$(nvm which default)   # 값을 직접 붙여넣기 (명령 자체를 적으면 안 됨)
#   MCP_NPX_BIN=$(command -v npx)       # 미지정 시 PATH 에서 자동 탐색
MCP_NODE_BIN=
MCP_NPX_BIN=
MCP_UVX_BIN=

## Figma
# https://www.figma.com/developers/api#access-tokens
MCP_FIGMA_API_KEY=

## Atlassian (Jira + Confluence)
# https://id.atlassian.com/manage-profile/security/api-tokens
MCP_ATLASSIAN_JIRA_URL=https://your-domain.atlassian.net
MCP_ATLASSIAN_JIRA_USERNAME=your@email.com
MCP_ATLASSIAN_JIRA_API_TOKEN=
MCP_ATLASSIAN_CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
MCP_ATLASSIAN_CONFLUENCE_USERNAME=your@email.com
MCP_ATLASSIAN_CONFLUENCE_API_TOKEN=

## Sentry
# https://sentry.io/settings/account/api/auth-tokens/
MCP_SENTRY_ACCESS_TOKEN=

## Slack
# 모드: stdio(기본) → 최종 키 slack / oauth → 최종 키 slack-oauth (둘 중 하나만 생성)
MCP_SLACK_MODE=stdio
# stdio일 때만 필요 — https://api.slack.com/apps → User OAuth Token (xoxp-...), Bot(xoxb) 아님
# oauth일 때는 비워 두고 IDE에서 Slack OAuth Connect
MCP_SLACK_XOXP_TOKEN=

## GitHub
# https://github.com/settings/tokens (classic) 또는 fine-grained PAT
# private 레포 PR/이슈면 repo(또는 Contents·Issues·Pull requests) 권한 필요. org면 SSO Authorize
MCP_GITHUB_PERSONAL_ACCESS_TOKEN=

## Supabase
# https://supabase.com/dashboard/account/tokens
MCP_SUPABASE_ACCESS_TOKEN=
